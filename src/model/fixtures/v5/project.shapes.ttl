    sh:property _:jxevkldjszm ;
    sh:property _:xltsp5wyszm .

_:6nzf1yakszm
    sh:path :name ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "A person has a name." .

_:jxevkldjszm
    sh:path :age ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 .

_:xltsp5wyszm
